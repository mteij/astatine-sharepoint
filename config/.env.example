# Copy to config/.env and fill in. Never commit config/.env.

# Local development only (production: leave unset so debug is off and cookies are Secure)
DEBUG=true
SESSION_COOKIE_SECURE=false

# Entra ID app registration (single tenant, "Web" platform)
# Redirect URI must match exactly. Delegated API permissions needed (admin consent):
#   User.Read, Team.ReadBasic.All, Channel.ReadBasic.All, Files.Read.All
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:8765/callback

REQUEST_ACCESS_URL=mailto:board@astatine.utwente.nl
# Teams Workflows URL ("Post to a channel when a webhook request is received") of the board channel.
# Secret: keep it in config/.env only. When empty, "Request access" falls back to REQUEST_ACCESS_URL.
REQUEST_ACCESS_WEBHOOK_URL=
# Team ID(s), comma separated, whose channels are offered in the request form. The form lists them with an
# app-only token, so grant the Entra app the *application* permission Channel.ReadBasic.All (admin consent).
REQUEST_ACCESS_TEAM_IDS=
