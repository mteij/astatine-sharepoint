# Copy to config/.env and fill in. Never commit config/.env.

# Local development only (production: leave unset so debug is off and cookies are Secure)
DEBUG=true
SESSION_COOKIE_SECURE=false

# Entra ID app registration (single tenant, "Web" platform)
# Redirect URI must match exactly. Delegated API permissions needed (admin consent):
#   User.Read, Team.ReadBasic.All, Channel.ReadBasic.All, Files.Read.All
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:8765/callback

REQUEST_ACCESS_URL=mailto:board@astatine.utwente.nl
# SharePoint list that receives access requests (the app writes with an app-only token).
# Needs the *application* permission Sites.Selected, granted with "write" on this one site only.
# List columns (internal names): Title (email), Name, Committee, Note.
# When the site is empty, "Request access" falls back to REQUEST_ACCESS_URL.
REQUEST_ACCESS_SITE=
REQUEST_ACCESS_LIST=Committee Requests
# Optional. By default the request form offers the channels of every team the signed-in user belongs to.
# Set team ID(s), comma separated, to restrict it. Channels are listed with an app-only token, so grant the
# Entra app the *application* permission Channel.ReadBasic.All (admin consent).
REQUEST_ACCESS_TEAM_IDS=
# Channel IDs (comma separated) that may be requested; nothing else is offered or accepted, and empty allows none.
# List channels with Graph: GET /teams/{team-id}/channels (the id looks like 19:...@thread.tacv2).
REQUEST_ACCESS_CHANNEL_IDS=

# Production only: the public address of the site (required, host-header protection).
# APP_FULL_BASE_URL=https://webapps.astatine.utwente.nl
