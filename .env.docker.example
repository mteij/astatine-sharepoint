# Copy to .env.docker and fill in. Never commit .env.docker.

# Required. Long random string, e.g. `openssl rand -hex 32`.
SECURITY_SALT=

# Public address of the site. Required in production (host-header protection).
APP_FULL_BASE_URL=https://webapps.astatine.utwente.nl

# Entra ID app registration. Add the redirect URI below to the app in Entra.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=https://webapps.astatine.utwente.nl/callback

REQUEST_ACCESS_URL=mailto:board@astatine.utwente.nl
REQUEST_ACCESS_WEBHOOK_URL=
WEBAPPS_URL=https://webapps.astatine.utwente.nl
